# ══════════════════════════════════════════════════════════════════════════════
#  Cloudflare Agents Telegram Bot — ملف الإعدادات
#  انسخ هذا الملف إلى `.env` ثم عدّل القيم:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── إلزامي ────────────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AA-your-telegram-bot-token-here
# معرّفات المشرفين (أرقام) — افصل بينها بفاصلة. استخدم أمر /id داخل البوت لمعرفة رقمك.
ADMIN_IDS=111111111,222222222

# ── التحكم بالوصول ─────────────────────────────────────────────────────────────
# الوضع: admins (المشرفون فقط — الافتراضي) | allowlist (قائمة محادثات) | open (الجميع)
ACCESS_MODE=admins
# محادثات/قنوات/مجموعات إضافية مسموح لها (تُستخدم مع ACCESS_MODE=allowlist)
ALLOWED_CHATS=
# هل يُسمح للبوت بالعمل داخل المجموعات؟
ALLOW_GROUPS=false

# ── النموذج ────────────────────────────────────────────────────────────────────
DEFAULT_MODEL=@cf/zai-org/glm-4.7-flash
# نماذج بديلة تُجرَّب تلقائياً عند تجاوز حد المعدل (rate limit) أو فشل النموذج
FALLBACK_MODELS=@cf/zai-org/glm-5.2,@cf/openai/gpt-oss-120b,@cf/google/gemma-4-26b-a4b-it
# نموذج رخيص/سريع يُستخدم للتذكير والتلخيص وضغط الذاكرة
UTILITY_MODEL=@cf/zai-org/glm-4.7-flash

# ── شخصية الوكيل ───────────────────────────────────────────────────────────────
# اتركه فارغاً لاستخدام الشخصية الافتراضية المدمجة (عربية/إنجليزية تلقائياً)
SYSTEM_PROMPT=
# عدد خطوات الوكيل القصوى (كل خطوة = استدعاء نموذج + تنفيذ أدوات)
MAX_STEPS=10
# أقصى مدة للخطوة الواحدة بالثواني
STEP_TIMEOUT=180
# مهلة الأداة الواحدة بالثواني
TOOL_TIMEOUT=45
# أقصى حجم لمخرجات الأداة (أحرف) قبل الاقتطاع
MAX_TOOL_OUTPUT=8000

# ── الأدوات الداخلية ──────────────────────────────────────────────────────────
# تفعيل تنفيذ كود Python داخل صندوق معزول
ENABLE_PYTHON=true
# تفعيل تنفيذ أوامر shell (للمشرفين فقط دائماً)
ENABLE_SHELL=true
# مجلد العمل المعزول (كائنات الملفات + مخرجات الكود)
WORKSPACE_DIR=./data/workspace
# أدوات معطّلة (أسماء مفصولة بفاصلة) — مثال: shell_exec,file_delete
DISABLED_TOOLS=
# أدوات مفعّلة حصرياً (اتركه فارغاً لتفعيل كل شيء)
ENABLED_TOOLS_ONLY=
# السماح للأدوات بالوصول إلى الشبكة (http_request/web_fetch/web_search)
ENABLE_WEB_TOOLS=true
# مزوّد البحث: auto (يجرّب API ثم HTML) | html | tavily | brave | serper | searxng
# محركات HTML (DuckDuckGo/Bing) قد تُحجب من عناوين مراكز البيانات — المزوّد عبر API أدقّ.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
# عنوان مثيل SearXNG خاص بك (اختياري): https://search.example.com
SEARXNG_URL=
# ويكيميديا تشترط User-Agent يحتوي رابط اتصال صالح (وإلا 403)
WIKI_USER_AGENT=3mh-agent/2.0 (+http://3mh.pages.dev; contact: t.me/j49_c)
# حجم ذاكرة Python/Shell القصوى بالميغابايت
SANDBOX_MEMORY_MB=1024

# ── الذاكرة والسياق ───────────────────────────────────────────────────────────
# أقصى عدد تقريبي للتوكنز في السياق المُرسل
MAX_CONTEXT_TOKENS=24000
# ضغط تلقائي للسجل عند تجاوز هذه النسبة من الحد الأعلى (0 = تعطيل)
COMPACT_RATIO=0.85

# ── واجهة تليجرام ─────────────────────────────────────────────────────────────
# الأزرار الملوّنة (Bot API 9.4+): 🟢 success • 🔵 primary • 🔴 danger
BUTTON_COLORS=true
# لوحة الأزرار الدائمة أسفل صندوق الإدخال (تشغيل البوت بالأزرار)
MENU_BUTTONS=true
# اسم الوكيل الظاهر في الرسائل وبرومبت النظام
BOT_NAME=3mh agent
# لغة الواجهة: ar | en | auto (تلقائي حسب لغة المستخدم)
UI_LANGUAGE=ar
# البث الحي: تعديل الرسالة أثناء التوليد
STREAM_EDITS=true
# الفاصل الأدنى بين تعديلين للرسالة بالثواني (حد تليجرام ~1/ث)
STREAM_EDIT_INTERVAL=1.0
# إظهار تفكير النموذج (reasoning) في البث
SHOW_REASONING=false
# إظهار سجل خطوات الأدوات (🔧 أداة ← نتيجة)
SHOW_TOOL_TRACE=true
# إظهار إحصاءات الاستخدام (توكنز/تكلفة/زمن) أسفل الرد
SHOW_USAGE=true
# حد الطلبات لكل محادثة في الدقيقة
RATE_LIMIT_PER_MIN=20

# ── التخزين ────────────────────────────────────────────────────────────────────
DB_PATH=./data/bot.sqlite3
# الاحتفاظ بسجل الاستخدام لعدد أيام
USAGE_RETENTION_DAYS=60

# ── الشبكة / النشر ────────────────────────────────────────────────────────────
CF_BASE_URL=wss://playground.ai.cloudflare.com
CF_ORIGIN=https://playground.ai.cloudflare.com
# عدد محاولات إعادة الاتصال عند انقطاع WebSocket
WS_MAX_RETRIES=4
# ترك تشغيل وضع Webhook (اتركه فارغاً لاستخدام long polling)
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8443
# بروكسي HTTP/SOCKS للبوت إن لزم (اتركه فارغاً)
PROXY_URL=
LOG_LEVEL=INFO
LOG_FILE=./data/bot.log
