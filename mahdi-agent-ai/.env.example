# ============================================================
#  MAHDI AGENT AI — environment configuration
#  Copy this file to ".env" and fill in what you need.
#  Every model is optional. Without keys the built-in
#  "MAHDI Demo" model works fully offline.
# ============================================================

# --- Server -------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Optional: protect the app with a token (recommended when exposed publicly)
# MAHDI_ACCESS_TOKEN=change-me-to-a-long-random-string
# Max model/tool round-trips per user message
MAHDI_MAX_STEPS=12
# Where conversations and project files are stored
# MAHDI_DATA_DIR=./data

# --- Model providers (enable any) ---------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local models through Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
